---
import "../styles/tokens.css";

interface Props {
  title?: string;
}

const { title = "open-aeo" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Track whether AI answer engines cite your domain."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
