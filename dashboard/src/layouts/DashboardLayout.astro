---
/*
 * The app shell. Deliberately separate from Layout.astro: the marketing pages
 * keep their dark token sheet, while the dashboard is a light Tailwind/shadcn
 * surface and must not inherit those tokens or Preflight into the landing page.
 */
import "../styles/globals.css";

interface Props {
  title?: string;
}

const { title = "Dashboard · open-aeo" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
